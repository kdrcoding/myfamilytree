# Supabase project credentials — see README "Shared data with Supabase".
#
# 1. Copy this file to `.env` (which is git-ignored — NEVER commit real values).
# 2. In the Supabase dashboard open Project Settings -> API and copy:
#    - Project URL        -> VITE_SUPABASE_URL
#    - anon / public key  -> VITE_SUPABASE_ANON_KEY
#
# The anon key is safe to expose in the browser (access is controlled by the
# RLS policies in supabase/migrations). Never put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
